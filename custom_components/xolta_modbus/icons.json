{
  "entity": {
    "sensor": {
      "state": { "default": "mdi:battery-heart-variant" },
      "charge_limit": { "default": "mdi:battery-arrow-up" },
      "discharge_limit": { "default": "mdi:battery-arrow-down" },
      "energy_charged": { "default": "mdi:battery-plus" },
      "energy_discharged": { "default": "mdi:battery-minus" },
      "override_ends": { "default": "mdi:timer-outline" }
    },
    "binary_sensor": {
      "override_contested": { "default": "mdi:cloud-alert" }
    },
    "select": {
      "override": {
        "default": "mdi:battery-sync",
        "state": {
          "auto": "mdi:cloud-outline",
          "stop": "mdi:battery-off-outline",
          "self_consumption": "mdi:home-battery"
        }
      }
    },
    "number": {
      "override_duration": { "default": "mdi:timer-cog-outline" }
    }
  },
  "services": {
    "set_override": { "service": "mdi:battery-sync" }
  }
}
